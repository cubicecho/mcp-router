# Bearer token protecting /api/* and /mcp* — pick something long and random,
# e.g. `openssl rand -hex 32`.
MCP_ROUTER_TOKEN=change-me

# Trusted local network escape hatch: set to true to disable bearer auth
# entirely (no token needed for /api or /mcp). Overrides the token above.
# Leave unset/false unless the router is unreachable from untrusted networks.
# SECURE_LOCAL_NET=true

# How long an idle client connection is kept open, in ms (default 75000; 0 never
# closes one). Keep it above the idle timeout of any reverse proxy in front.
# HTTP_KEEP_ALIVE_TIMEOUT_MS=75000

# How long an idle connection to a remote MCP server is kept open, in ms, when
# that server does not say (default 30000).
# HTTP_OUTBOUND_KEEP_ALIVE_TIMEOUT_MS=30000
