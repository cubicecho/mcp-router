# Signs the web UI's sessions. Production (npm start, the Docker image) refuses
# to start without a strong one: generate it with `openssl rand -hex 32`.
# Development falls back to a built-in secret when it is unset.
# BETTER_AUTH_SECRET=

# Trusted local network: whoever opens the web UI is signed in as the local
# admin, with no OIDC provider. MCP clients and agents still need an API key,
# made in the UI's Settings. Only on a network nothing hostile can reach: the
# router refuses it when its publicUrl is not a private address, unless
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=true.
# SECURE_LOCAL_NET=true
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=true

# Sign in through an OpenID Connect provider (heautou, Keycloak, Authentik, ...).
# The easier way is to leave these unset and paste a setup URL from the
# provider into the login page (on a new router) or Settings (as the admin):
# the router then registers itself with the provider. Set here, the provider
# wins and cannot be changed from the UI. Register the redirect URI the server
# prints at boot: <publicUrl>/api/auth/callback/oidc
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=mcp-router
# OIDC_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post; the provider must agree.
# OIDC_CLIENT_AUTH=client_secret_basic
# What the login page's button calls it. Default: SSO
# OIDC_NAME=heautou

# Sign-in attempts are throttled per client address. Behind a reverse proxy,
# say how many hops to believe X-Forwarded-For from (or `loopback`, a subnet).
# TRUST_PROXY=1

# Upgrading: the token MCP clients used before API keys. It is imported on boot
# as an API key with the same value, so they keep working. Revoke it in
# Settings once they have keys of their own (unset this first, or it comes back).
# MCP_ROUTER_TOKEN=

# The router's Postgres. Required: boot refuses to start without a postgres://
# URL. `npm run db:up` starts one for development on localhost:5433 (the URL
# below). DB_CONNECT_TIMEOUT_MS is how long boot waits for Postgres to answer
# (default 60000).
DATABASE_URL=postgres://mcp_router:mcp_router@localhost:5433/mcp_router
# DB_CONNECT_TIMEOUT_MS=60000

# How long an idle client connection is kept open, in ms (default 75000; 0 never
# closes one). Keep it above the idle timeout of any reverse proxy in front.
# HTTP_KEEP_ALIVE_TIMEOUT_MS=75000

# How long an idle connection to a remote MCP server is kept open, in ms, when
# that server does not say (default 30000).
# HTTP_OUTBOUND_KEEP_ALIVE_TIMEOUT_MS=30000
