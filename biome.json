{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": ["./no-negation.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "useImportType": "error",
        "useConst": "error",
        "useBlockStatements": "error",
        "noCommonJs": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "noUnusedTemplateLiteral": "off",
        "noMagicNumbers": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.css",
      "!**/dist",
      "!**/node_modules",
      "!.claude",
      "!**/data",
      "!site",
      "!**/*.gen.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["app/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "app/src/components/ui/**",
        "app/cubeui-*.css",
        "app/src/lib/color.ts",
        "app/src/lib/utils.ts",
        "app/src/components/action-button.tsx",
        "app/src/components/app-form.tsx",
        "app/src/components/card-layout.tsx",
        "app/src/components/confirm-button.tsx",
        "app/src/components/description-list.tsx",
        "app/src/components/dialog-layout.tsx",
        "app/src/components/disclosure-row.tsx",
        "app/src/components/field-row.tsx",
        "app/src/components/form-field.tsx",
        "app/src/components/header-content-footer.tsx",
        "app/src/components/option-select.tsx",
        "app/src/components/page-header.tsx",
        "app/src/components/page-layout.tsx",
        "app/src/components/page.tsx",
        "app/src/components/password-field.tsx",
        "app/src/components/password-input.tsx",
        "app/src/components/query-state.tsx",
        "app/src/components/section.tsx",
        "app/src/components/setting-row.tsx",
        "app/src/components/sidebar.tsx",
        "app/src/components/split-layout.tsx"
      ],
      "linter": {
        "enabled": false
      }
    }
  ]
}
