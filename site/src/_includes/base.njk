<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}" />
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}" />
    <!-- The shared theme first, then this project's own rules on top of it. -->
    <link rel="stylesheet" href="{{ '/css/cubesite.css' | url }}" />
    <link rel="stylesheet" href="{{ '/css/site.css' | url }}" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="{{ '/' | url }}">
        {% include "mark.njk" %}
        <span class="name">{{ site.name }}</span>
      </a>
      {# page.url carries no path prefix, so it is compared with the bare path. #}
      <nav>
        <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
        <a href="{{ '/get-started/' | url }}"{% if page.url == '/get-started/' %} aria-current="page"{% endif %}>Get started</a>
        <a href="{{ '/docs/' | url }}"{% if page.url == '/docs/' %} aria-current="page"{% endif %}>Docs</a>
        <a href="{{ site.repo }}" rel="noopener">GitHub ↗</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>{{ site.name }} — an MCP gateway. Not affiliated with Anthropic or the MCP project.</span>
      <span class="footer-links">
        <a href="{{ site.repo }}" rel="noopener">Source</a>
        <a href="{{ site.dockerHub }}" rel="noopener">Docker Hub</a>
        <a href="https://modelcontextprotocol.io" rel="noopener">Model Context Protocol</a>
        <a href="{{ '/docs/' | url }}">Docs</a>
      </span>
    </footer>
  </body>
</html>
